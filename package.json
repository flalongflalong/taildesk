{
  "name": "taildesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "test": ".venv/bin/python -m pytest -q",
    "start": ".venv/bin/python -m server",
    "format": "prettier --write src scripts/novnc-orientation.mjs vite.config.ts tsconfig.json package.json index.html",
    "format:check": "prettier --check src scripts/novnc-orientation.mjs vite.config.ts tsconfig.json package.json index.html",
    "test:controls": "node --experimental-strip-types --test tests/remote.test.mjs",
    "release:check": "python3 scripts/release.py",
    "release:source": "python3 scripts/release.py --export release/taildesk-source.zip"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "3.6.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  },
  "description": "A self-hosted, mobile-friendly VNC gateway for Tailscale networks",
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  }
}
