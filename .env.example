# Copy this file to .env. Local-only use: leave both origins empty.
# Recommended for Tailscale Serve: use the EXACT HTTPS origin it prints.
# Example only: https://gateway.example.ts.net (no path or trailing slash).
PRIVATE_ORIGIN=
# Optional additional HTTPS reverse-proxy origin; not needed for Tailscale Serve.
PUBLIC_ORIGIN=
PORT=8787

# Enable only when using npm run dev (Vite on port 5173).
DEVELOPMENT=0

# Optional: persistent data directory, defaults to project .data/.
# TAILDESK_DATA_DIR=/absolute/path/to/private/taildesk-data
